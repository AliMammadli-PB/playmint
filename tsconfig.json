{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-redesign/types/**/*.ts",
    ".next-redesign/dev/types/**/*.ts",
    ".next-redesign-final/types/**/*.ts",
    ".next-redesign-final/dev/types/**/*.ts",
    ".next-redesign-release/types/**/*.ts",
    ".next-redesign-release/dev/types/**/*.ts",
    ".next-redesign-v1/types/**/*.ts",
    ".next-redesign-v1/dev/types/**/*.ts",
    ".next-redesign-v2/types/**/*.ts",
    ".next-redesign-v2/dev/types/**/*.ts",
    ".next-redesign-v3/types/**/*.ts",
    ".next-redesign-v3/dev/types/**/*.ts",
    ".next-redesign-v4/types/**/*.ts",
    ".next-redesign-v4/dev/types/**/*.ts",
    ".next-montserrat-social/types/**/*.ts",
    ".next-montserrat-social/dev/types/**/*.ts",
    ".next-montserrat-social-final/types/**/*.ts",
    ".next-montserrat-social-final/dev/types/**/*.ts",
    ".next-portal-20261007/types/**/*.ts",
    ".next-portal-20261007/dev/types/**/*.ts",
    ".next-portal-release-20261007/types/**/*.ts",
    ".next-portal-release-20261007/dev/types/**/*.ts",
    ".next-portal-live-20261007/types/**/*.ts",
    ".next-portal-live-20261007/dev/types/**/*.ts",
    ".next-opensource-20261007/types/**/*.ts",
    ".next-opensource-20261007/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
