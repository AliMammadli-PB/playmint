      "html": "<button class=\"ds-btn-primary\">Continue</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-sans,DM Sans,sans-serif);font-weight:600;min-height:44px;border-radius:var(--radius-control,10px);padding:11px 18px;font-size:14px;line-height:1.3;cursor:pointer;transition:background-color .18s ease,border-color .18s ease;border:0;background:var(--color-mint);color:var(--accent-ink);}.ds-btn-primary:hover{background:var(--color-mint-2)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-mint);outline-offset:4px}.ds-btn-primary:disabled{opacity:.5;cursor:not-allowed}",
      "refersTo": "button-primary"
