      "name": "Text Field",
      "kind": "input",
      "description": "Text Field from the implemented shared visual system.",
      "html": "<label class=\"ds-label\" for=\"ds-title\">Game title</label><input id=\"ds-title\" class=\"ds-input\" placeholder=\"Game title\" />",
      "css": ".ds-label{display:block;margin-bottom:6px;font:650 14px var(--font-sans,DM Sans,sans-serif);color:var(--color-paper)}.ds-input{width:100%;min-height:46px;border-radius:var(--radius-control);border:1px solid var(--color-line-strong);background:var(--color-surface);color:var(--color-paper);padding:11px 14px;font:16px/1.5 var(--font-sans,DM Sans,sans-serif);caret-color:var(--color-mint)}.ds-input::placeholder{color:var(--color-faint)}.ds-input:focus{outline:2px solid var(--color-mint);outline-offset:2px}",
      "refersTo": "input"
    },
    {
      "name": "Category Chip",
      "kind": "chip",
      "description": "Category Chip from the implemented shared visual system.",
      "html": "<a class=\"ds-chip\" href=\"#\" aria-current=\"page\">Casual</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;min-height:44px;border:1px solid var(--color-line-strong);border-radius:var(--radius-control);padding:10px 15px;font:14px var(--font-sans,DM Sans,sans-serif);color:var(--color-muted);background:var(--color-surface);text-decoration:none}.ds-chip[aria-current],.ds-chip:hover{color:var(--color-mint);border-color:var(--color-mint)}.ds-chip:focus-visible{outline:2px solid var(--color-mint);outline-offset:4px}",
      "refersTo": "category-chip"
    },
    {
      "name": "Panel",
      "kind": "card",
      "description": "Panel from the implemented shared visual system.",
      "html": "<section class=\"ds-panel\"><h2>Publishing journey</h2><p>Upload, review, and publish.</p></section>",
      "css": ".ds-panel{border:1px solid var(--color-line);border-radius:var(--radius-panel);background:var(--color-surface);color:var(--color-paper);padding:24px;font:14px/1.6 var(--font-sans,DM Sans,sans-serif)}.ds-panel h2{font:650 20px/1.2 var(--font-display,Space Grotesk,sans-serif);letter-spacing:-.035em;margin:0 0 12px}.ds-panel p{color:var(--color-muted);margin:0}",
      "refersTo": "card"
    },
    {
      "name": "Studio Navigation",
      "kind": "nav",
      "description": "Studio Navigation from the implemented shared visual system.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Studio\"><a href=\"#\" aria-current=\"page\">Overview</a><a href=\"#\">My games</a></nav>",
      "css": ".ds-nav{display:grid;gap:4px}.ds-nav a{display:flex;align-items:center;gap:12px;padding:11px 12px;min-height:44px;border-radius:var(--radius-control);color:var(--color-muted);font:14px var(--font-sans,DM Sans,sans-serif);text-decoration:none}.ds-nav a:hover{background:var(--color-surface-2)}.ds-nav a[aria-current]{background:var(--color-surface-3);color:var(--color-mint);font-weight:650}.ds-nav a:focus-visible{outline:2px solid var(--color-mint);outline-offset:4px}"
    },
    {
      "name": "Version Timeline",
      "kind": "custom",
      "description": "Version Timeline from the implemented shared visual system.",
      "html": "<ol class=\"ds-timeline\"><li data-complete=\"true\"><span>✓</span>Uploaded</li><li><span>2</span>Security scan</li><li><span>3</span>Admin review</li><li><span>4</span>Playable output kept</li></ol>",
      "css": ".ds-timeline{display:flex;flex-wrap:wrap;gap:12px;margin:18px 0;padding:0;list-style:none;font-family:var(--font-sans,DM Sans,sans-serif)}.ds-timeline li{color:var(--color-muted);display:flex;align-items:center;gap:8px;font-size:13px}.ds-timeline li[data-complete=true]{color:var(--color-mint)}.ds-timeline span{display:grid;place-items:center;border:1px solid currentColor;border-radius:50%;width:24px;height:24px;font-size:12px}"
    },
    {
      "name": "ZIP Picker",
      "kind": "custom",
      "description": "ZIP Picker from the implemented shared visual system.",
      "html": "<label class=\"ds-zip\"><svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M12 16V4m-4 4 4-4 4 4M4 14v6h16v-6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><strong>Choose ZIP file</strong><span>Upload your game files</span><input type=\"file\" accept=\".zip\" aria-label=\"Choose ZIP file\" /></label>",
      "css": ".ds-zip{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;border:2px dashed var(--color-line-strong);background:var(--color-surface-2);border-radius:12px;min-height:200px;padding:24px;overflow:hidden;font-family:var(--font-sans,DM Sans,sans-serif)}.ds-zip svg{color:var(--color-mint)}.ds-zip strong{color:var(--color-paper);font-size:15px;margin-top:14px;max-width:100%;overflow-wrap:anywhere}.ds-zip span{font-size:13px;color:var(--color-muted);margin-top:6px}.ds-zip input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}.ds-zip:focus-within{outline:2px solid var(--color-mint);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Arcade and Studio",
    "overview": "Arcade Dark and Studio share one visual language with two working environments. The public environment uses deep charcoal surfaces and luminous mint actions; Studio and admin use pale green-gray grounds, white panels, and darker mint actions. Space Grotesk headings and DM Sans body copy connect the environments.\n\nThe system is direct, spacious, and game-led. Solid fills, visible borders, and compact rounded controls keep navigation and forms clear. Existing generated PNG identity assets and original illustrations remain recognizable; SVG flags represent language choices. Motion stays brief and follows reduced-motion preferences.",
    "keyCharacteristics": [
      "Dark public Arcade with related light Studio/admin.",
      "One semantic color vocabulary across both environments.",
      "Solid surfaces, visible boundaries, and mint actions.",
      "Responsive navigation, keyboard focus, and readable controls.",
      "Existing PNG identity assets and SVG language flags."
    ],
    "rules": [],
    "dos": [
      "Do preserve the public dark and Studio/admin light environments.",
      "Do use semantic color roles so shared components follow their environment.",
      "Do retain the existing generated PNG brand mark and use SVG language flags.",
      "Do preserve visible keyboard focus and reduced-motion behavior.",
      "Do use square cover frames for catalogue game cards."
    ],
    "donts": [
      "Don't replace authentic game covers with invented game artwork.",
      "Don't hide action labels or focus indicators in forms.",
      "Don't replace the established brand mark with a text-only approximation."
    ]
  }
}
